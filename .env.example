# ICS endpoint configuration
ICS_BASE_URL=https://ics.example.com
ICS_MCP_RESOURCE_URI=https://ics.example.com/mcp

# OAuth client (pre-registered public PKCE client in ICS, no secret)
ICS_MCP_OAUTH_CLIENT_ID=ics-mcp-stdio

# Transport
ICS_MCP_TRANSPORT=stdio
ICS_MCP_HTTP_HOST=127.0.0.1
ICS_MCP_HTTP_PORT=8765
ICS_MCP_STATELESS=false

# Token storage
ICS_MCP_KEYRING_SERVICE=ics-mcp
ICS_MCP_TOKEN_FALLBACK_PATH=

# Behavior
ICS_MCP_DEFAULT_CONFIRM=interactive
# Let the model switch its own session to yolo (confirmations off). Keep false
# unless every caller is trusted.
ICS_MCP_ALLOW_YOLO=false
ICS_MCP_LOG_LEVEL=INFO

# Performance
ICS_MCP_RESPONSE_MAX_CHARS=8000
ICS_MCP_HTTP_TIMEOUT_READ=30
ICS_MCP_HTTP_TIMEOUT_WRITE=300
